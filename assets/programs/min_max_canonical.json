  "techniques": {
   "drop_sets_2x25": {
    "name": "Two Drop Sets (~25% per)",
    "when": "After the final working set only",
    "description": "After reaching failure, reduce the weight by ~25% and go to failure again. Repeat once more (3 back-to-back sets in total).",
    "drops": 2,
    "drop_pct": 25
   },
   "myo_reps": {
    "name": "Myo-reps",
    "when": "After the final working set only",
    "description": "After failure, rest 5 seconds and attempt 2 more reps. Repeat (5 s rest → 2 reps) until you fail to complete 2 full-ROM reps (usually within 1-3 cycles).",
    "rest_s": 5,
    "reps_per_cycle": 2
   },
   "weighted_static_hold_30s": {
    "name": "Weighted Static Hold (30 sec)",
    "when": "After the final working set of Standing Calf Raise (or its substitution)",
    "description": "After failing, hold the bottom position under full calf tension for 30 seconds.",
    "hold_s": 30
   },
   "lengthened_partials": {
    "name": "Lengthened Partials",
    "when": "After the final working set only",
    "description": "After reaching failure with full ROM, keep doing partial reps in the stretched position until failure.",
    "used_in_this_version": false
   }
  },
  "progression": {
   "rule": "Once you can perform all working sets at the top of the rep range, increase the load next session.",
   "fallback": "If adding weight would drop you below the range, keep the same weight and extend the range slightly (e.g. 6-8 → aim for 6-10).",
   "tracking": "Log load and reps for every working set."
  },
